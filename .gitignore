# .gitignore
# ── Secrets — NEVER commit these ──────────────────────────────
.env
envs/dev.env.local
envs/staging.env.local
envs/prod.env.local

# ── Backups ───────────────────────────────────────────────────
/backups/
*.dump
*.sql.gz

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Temp ─────────────────────────────────────────────────────
/tmp/
*.log
