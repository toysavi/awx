# .gitignore
# ============================================================
# NEVER commit real secrets to Git.
# ============================================================

# Secret files — contain real passwords and credentials
k8s/overlays/dev/secrets.env
k8s/overlays/staging/secrets.env
k8s/overlays/prod/secrets.env
k8s/base/secrets.env

# Kubeconfig files
*.kubeconfig
kubeconfig
.kube/

# Generated manifests (build artifacts)
/tmp/manifest-*.yaml

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Ansible vault password files
.vault_pass
.ansible-vault-password

# Python
__pycache__/
*.pyc
.venv/
venv/

# Terraform (if added later)
*.tfstate
*.tfstate.backup
.terraform/
