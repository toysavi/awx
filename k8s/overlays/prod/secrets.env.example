# k8s/base/secrets.env.example
# ============================================================
# EXAMPLE SECRETS FILE — DO NOT COMMIT REAL VALUES TO GIT
# ============================================================
# Copy this file to secrets.env and fill in real values.
# secrets.env is gitignored. In CI/CD these values come from
# GitHub Actions Secrets injected as environment variables.
# ============================================================

# PostgreSQL superuser password (used by AWX to connect to the DB)
POSTGRES_PASSWORD=change_me_strong_password_here

# PostgreSQL database name for AWX
POSTGRES_DB=awx

# PostgreSQL username for AWX
POSTGRES_USER=awx

# AWX admin user password (initial setup)
# After first login, change this via the AWX UI.
AWX_ADMIN_PASSWORD=change_me_awx_admin_password
