# .env.example
# ============================================================
# AWX Docker Compose Environment Variables
# Copy to .env and fill in real values:
#   cp .env.example .env
#   nano .env
#
# .env is gitignored — NEVER commit real passwords to Git.
# ============================================================

# ── AWX Version ───────────────────────────────────────────────
# Find latest: https://github.com/ansible/awx/releases
AWX_VERSION=24.6.1

# ── AWX Admin Credentials ─────────────────────────────────────
# Used on first startup to create the admin account.
# Change via AWX UI after first login.
AWX_ADMIN_USER=admin
AWX_ADMIN_PASSWORD=change_me_strong_password
AWX_ADMIN_EMAIL=admin@example.com

# ── Django Secret Key ─────────────────────────────────────────
# MUST be random and secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be identical across awx-web and awx-task containers.
SECRET_KEY=change_me_generate_a_random_secret_key_here

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=awx
POSTGRES_USER=awx
POSTGRES_PASSWORD=change_me_strong_db_password

# ── Port Configuration ────────────────────────────────────────
# AWX direct access port (used without nginx)
AWX_WEB_PORT=80
# Nginx ports (used in production)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ── Environment Tag ───────────────────────────────────────────
# Used in logging and monitoring. Values: dev, staging, prod
ENVIRONMENT=dev
