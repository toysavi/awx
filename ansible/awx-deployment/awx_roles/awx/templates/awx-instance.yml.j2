apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: awx
  namespace: {{ awx_namespace }}

spec:
  admin_user: {{ awx_admin_user }}
  admin_email: {{ awx_admin_email | default('admin@example.com') }}
  admin_password_secret: awx-admin-password

  hostname: {{ awx_fqdn }}

  # --------------------------------------------------
  # RESOURCE LIMITS
  # --------------------------------------------------
  web_resource_requirements:
    requests:
      memory: {{ awx_web_memory_request }}
    limits:
      memory: {{ awx_web_memory_limit }}

  task_resource_requirements:
    requests:
      memory: {{ awx_task_memory_request }}
    limits:
      memory: {{ awx_task_memory_limit }}

  postgres_resource_requirements:
    limits:
      memory: {{ awx_postgres_memory_limit }}

  # --------------------------------------------------
  # POSTGRES STORAGE
  # --------------------------------------------------
  postgres_storage_requirements:
    requests:
      storage: {{ awx_postgres_storage_size }}

  postgres_storage_class: {{ awx_postgres_storage_class }}

  # --------------------------------------------------
  # PROJECTS STORAGE (FIXED)
  # --------------------------------------------------
  projects_persistence: true

  projects_storage_access_mode: ReadWriteOnce   # ✅ REQUIRED FIX

  projects_storage_size: 8Gi

  # --------------------------------------------------
  # IMAGE
  # --------------------------------------------------
  image: quay.io/ansible/awx
  image_version: "{{ awx_version }}"

  # --------------------------------------------------
  # SERVICE
  # --------------------------------------------------
  service_type: ClusterIP

  ingress_type: none