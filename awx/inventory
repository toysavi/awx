# awx/inventory
# ============================================================
# AWX Inventory Reference
# This is a static inventory example.
# In production, AWX pulls inventories from SCM (this Git repo)
# using the ansible/inventories/ directory.
# ============================================================
[all:vars]
ansible_connection=ssh
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa

[k8s_nodes]
# Add your Kubernetes node IPs here
# node1 ansible_host=10.0.1.10
# node2 ansible_host=10.0.1.11

[awx_servers]
# Add AWX server IPs here
# awx ansible_host=10.0.1.5

[dev]
# Development hosts
# dev-server ansible_host=192.168.1.100

[staging]
# Staging hosts
# staging-server ansible_host=staging.example.com

[prod]
# Production hosts — be careful!
# prod-server1 ansible_host=prod1.example.com
# prod-server2 ansible_host=prod2.example.com
